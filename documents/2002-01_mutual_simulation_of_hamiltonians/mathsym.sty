\def\mathsymfont#1{\ifmmode{\mathchoice{%
    \mbox{\the\textfont0\ignorespaces#1}}{%
    \mbox{\the\textfont0\ignorespaces#1}}{%
    \mbox{\the\scriptfont0\ignorespaces#1}}{%
    \mbox{\the\scriptscriptfont0\ignorespaces#1}}}%
  \else{{\rm\ignorespaces#1}}\fi}

