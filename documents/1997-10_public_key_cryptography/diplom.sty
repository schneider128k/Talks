\newcounter{saveeqno}
\newenvironment{subeqnumbers}%
  {\refstepcounter{equation}%
% Gleichungsnummer erhoehen
   \setcounter{saveeqno}{\value{equation}}%
% aktuelle Gleichungsnummer speichern
   \setcounter{equation}{0}%
% Kleinbuchstabenzaehlung beginnt mit 'a'
   \def\theequation{\thechapter.\arabic{saveeqno}\alph{equation}}%
% Gleichungsnummer besteht aus Zahl mit angehaengtem Kleinbuchstaben
   \def\label##1{
   \immediate\write1{\string\newlabel{##1}%
   {{(\thechapter.\arabic{saveeqno}\alph{equation})}{\thepage}}}}
% Definition von \label anpassen
% sofort ins aux-File schreiben
   \def\mainlabel##1{
   \immediate\write1{\string\newlabel{##1}%
   {{(\thechapter.\arabic{saveeqno})}{\thepage}}}}}{%
\setcounter{equation}{\value{saveeqno}}}

